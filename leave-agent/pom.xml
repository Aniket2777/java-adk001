<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.ai.shrija</groupId>
    <artifactId>leave-agent</artifactId>
    <version>1.0.0</version>
    <name>leave-agent</name>
    <description>Leave Management Agent (ADK + MCP + A2A) built on Spring Boot</description>

    <properties>
        <java.version>21</java.version>
        <mcp-sdk.version>2.0.0</mcp-sdk.version>
        <a2a-sdk.version>0.3.3.Final</a2a-sdk.version>
    </properties>

    <dependencies>
        <!-- Core web / validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!--
          Model Context Protocol Java SDK.
          Used by LeaveMcpClient to talk to external MCP servers (e.g. HRMS, payroll systems).
          Verify the latest coordinates/version at https://github.com/modelcontextprotocol/java-sdk
        -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>${mcp-sdk.version}</version>
        </dependency>

        <!--
          Agent-to-Agent (A2A) protocol SDK.
          Used to expose this Leave Agent's AgentCard/task endpoint and to call
          the Manager / Payroll / Employee agents from client/*.java.
          Verify the latest coordinates/version at https://github.com/a2aproject/a2a-java
        -->
        <dependency>
            <groupId>io.github.a2asdk</groupId>
            <artifactId>a2a-java-sdk-client</artifactId>
            <version>${a2a-sdk.version}</version>
        </dependency>

<!--        <dependency>-->
<!--            <groupId>io.github.a2asdk</groupId>-->
<!--            <artifactId>a2a-java-sdk-server</artifactId>-->
<!--            <version>${a2a-sdk.version}</version>-->
<!--        </dependency>-->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
